# PDF Lambda — LaTeX resume generation
# ~700MB image (LaTeX only, no Playwright)

FROM public.ecr.aws/lambda/python:3.12

# Install LaTeX system dependencies
RUN dnf install -y \
    gcc \
    texlive-scheme-basic \
    texlive-collection-latexextra \
    texlive-collection-fontsrecommended \
    texlive-collection-fontsextra \
    texlive-xetex \
    texlive-collection-science \
    poppler-utils \
    && dnf clean all

# Verify LaTeX installation and configure TeXLive paths for Lambda read-only environment
ENV HOME=/tmp
ENV TEXMFVAR=/tmp/texmf-var
ENV TEXMFCONFIG=/tmp/texmf-config
RUN pdflatex --version && (fmtutil-sys --all || true)

# Copy requirements and install Python dependencies
COPY requirements-pdf.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application code
COPY . ${LAMBDA_TASK_ROOT}/

# Set the Lambda handler
CMD ["pdf_handler.handler"]
